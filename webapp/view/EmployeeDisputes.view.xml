<mvc:View
    controllerName="my.report.zmydisputes.controller.EmployeeDisputes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="disputesPage" title="{i18n>titleDisputesHistory}" showHeader="true">
        <content>
            <VBox id="vbDisputesContainer" class="sapUiTinyMargin">
                <fb:FilterBar id="filterBarDisputes" search=".onSearch" reset=".onReset" showClearOnFB="true">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem id="fgDispWorkDate" name="WorkDateGroup" label="{i18n>lblWorkDate}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker id="idDispWorkDateFilter" displayFormat="medium" valueFormat="yyyy-MM-dd" placeholder="{i18n>phSelectDate}"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem id="fgDispRequestType" name="RequestTypeGroup" label="{i18n>lblReqType}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="idDispRequestTypeFilter" placeholder="{i18n>phSelectReqType}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onRequestTypeValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>

                <Table id="disputesTable" items="{/MyDisputes}" mode="SingleSelectLeft" growing="true" growingThreshold="10" growingScrollToLoad="false" growingTriggerText="More">
                    <headerToolbar>
                        <OverflowToolbar id="disputeHeader">
                            <Title id="disputeTitle" text="{i18n>titleActualData}" level="H2"/>
                            <ToolbarSpacer id="tableSpacer"/>
                            <Button id="btnCancel" text="{i18n>btnCancelRequest}" type="Reject" icon="sap-icon://decline" press="onCancelDispute"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    
                    <columns>
                        <Column id="colWorkDate"><Text id="txtWorkDate" text="{i18n>lblWorkDate}"/></Column>
                        <Column id="colRequestType"><Text id="txtRequestType" text="{i18n>colReqType}"/></Column>
                        <Column id="colProposedIn"><Text id="txtProposedIn" text="{i18n>colProposedIn}"/></Column>
                        <Column id="colProposedOut"><Text id="txtProposedOut" text="{i18n>colProposedOut}"/></Column>
                        <Column id="colComment" width="15rem"><Text id="txtComment" text="{i18n>colReason}"/></Column>
                        <Column id="colStatus"><Text id="txtStatus" text="{i18n>colStatus}"/></Column>
                        <Column id="colApproverComment" width="15rem"><Text id="txtApproverCommentHeader" text="{i18n>colApproverComment}"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem id="itemDispute">
                            <cells>
                                <Text id="txtDate" text="{path:'WorkDate', type:'sap.ui.model.type.Date', formatOptions:{style:'medium'}}"/>
                                <Text id="txtReqType" text="{RequestType}"/>
                                <Text id="txtIn" text="{path:'ProposedIn', formatter: '.formatEdmTime'}"/>
                                <Text id="txtOut" text="{path:'ProposedOut', formatter: '.formatEdmTime'}"/>
                                <Text id="txtReason" text="{EmployeeComment}" wrapping="true" renderWhitespace="true" class="sapUiSelectable forceWordBreak" />
                                <ObjectStatus id="objStatus" text="{DisputeStatus}"/>
                                <Text id="txtApproverComment" text="{ApproverComment}" wrapping="true" renderWhitespace="true" class="sapUiSelectable forceWordBreak" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>