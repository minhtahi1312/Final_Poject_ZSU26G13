<mvc:View
    controllerName="my.report.zmydisputes.controller.EmployeeDisputes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="disputesPage" title="{i18n>titleDisputesHistory}" showHeader="true">
        <content>
            <VBox id="vbDisputesContainer" class="sapUiTinyMargin">
                <fb:FilterBar id="filterBarDisputes" search=".onSearch" reset=".onReset" clear=".onReset" showClearOnFB="true">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem id="fgDispWorkDate" name="WorkDateGroup" label="{i18n>lblWorkDate}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker id="idDispWorkDateFilter" displayFormat="medium" valueFormat="yyyy-MM-dd" placeholder="{i18n>phSelectDate}"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <fb:FilterGroupItem id="fgDispRequestType" name="RequestTypeGroup" label="{i18n>lblReqType}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="idDispRequestTypeFilter" placeholder="{i18n>phSelectReqType}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onRequestTypeValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>

                <Table id="disputesTable" items="{/MyDisputes}" mode="SingleSelectLeft" growing="true" growingThreshold="10" growingScrollToLoad="false" growingTriggerText="More">
                    <headerToolbar>
                        <OverflowToolbar id="disputeHeader">
                            <Title id="disputeTitle" text="{i18n>titleActualData}" level="H2"/>
                            <ToolbarSpacer id="tableSpacer"/>
                            <Button id="btnCancel" text="{i18n>btnCancelRequest}" type="Reject" icon="sap-icon://decline" press="onCancelDispute"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    
                    <columns>
    <!-- Cột Ngày: Căn giữa nhẹ hoặc trái -->
    <Column id="colWorkDate" width="8rem">
        <Text id="txtWorkDate" text="{i18n>lblWorkDate}"/>
    </Column>

    <!-- Cột Loại yêu cầu: Căn giữa để thẳng hàng với Status -->
    <Column id="colRequestType" hAlign="Center" width="9rem">
        <Text id="txtRequestType" text="{i18n>colReqType}"/>
    </Column>

    <!-- Cột Giờ vào: Căn giữa -->
    <Column id="colProposedIn" hAlign="Center" width="7rem">
        <Text id="txtProposedIn" text="{i18n>colProposedIn}"/>
    </Column>

    <!-- Cột Giờ ra: Căn giữa -->
    <Column id="colProposedOut" hAlign="Center" width="7rem">
        <Text id="txtProposedOut" text="{i18n>colProposedOut}"/>
    </Column>

    <!-- Cột Lý do: Căn trái, để tự co giãn chiếm không gian trống -->
    <Column id="colComment" minScreenWidth="Tablet" demandPopin="true">
        <Text id="txtComment" text="{i18n>colReason}"/>
    </Column>

    <!-- Cột Trạng thái: Căn giữa để badge nằm ngay ngắn -->
    <Column id="colStatus" hAlign="Center" width="9rem">
        <Text id="txtStatus" text="{i18n>colStatus}"/>
    </Column>

    <!-- Cột Ý kiến người duyệt: Căn trái, để tự co giãn -->
    <Column id="colApproverComment" minScreenWidth="Tablet" demandPopin="true">
        <Text id="txtApproverCommentHeader" text="{i18n>colApproverComment}"/>
    </Column>
</columns>

                    <items>
                        <ColumnListItem id="itemDispute">
                            <cells>
                               <Text id="txtDate" text="{path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}"/>
                                <ObjectStatus id="txtReqType"
              text="{RequestType}"
              state="{= ${RequestType} === 'OVERTIME' || ${RequestType} === 'REMOVE_WAR' ? 'Success' : 
                      (${RequestType} === 'LATE_COM' || ${RequestType} === 'EAR_LEV' ? 'Warning' : 
                      (${RequestType} === 'MISS_SWI' ? 'Error' : 
                      (${RequestType} === 'LEAVE' ? 'Information' : 'None'))) }" />
                                <Text id="txtIn" text="{path:'ProposedIn', formatter: '.formatEdmTime'}"/>
                                <Text id="txtOut" text="{path:'ProposedOut', formatter: '.formatEdmTime'}"/>
                                <Text id="txtReason" text="{EmployeeComment}" wrapping="true" renderWhitespace="true" class="sapUiSelectable forceWordBreak" />
                               <ObjectStatus id="objStatus"
              text="{DisputeStatus}" 
              inverted="true"
              state="{= ${DisputeStatus} === 'APPROVED' ? 'Success' : 
                      (${DisputeStatus} === 'PENDING' ? 'Warning' : 
                      (${DisputeStatus} === 'CANCELLED' || ${DisputeStatus} === 'REJECTED' ? 'Error' : 'None')) }" />
                                <Text id="txtApproverComment" text="{ApproverComment}" wrapping="true" renderWhitespace="true" class="sapUiSelectable forceWordBreak" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>