<mvc:View
    controllerName="my.report.zmydisputes.controller.EmployeeDisputes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="disputesPage" title=" Đơn Khiếu Nại " showHeader="true">
        <content>
            <Table id="disputesTable" 
                   items="{/MyDisputes}"
                   mode="SingleSelectLeft"
                   growing="true"
                   growingThreshold="10"
    growingScrollToLoad="false"
    growingTriggerText="Trang tiếp">
                <headerToolbar>
                    <OverflowToolbar id="disputeHeader">
                        <Title id="disputeTitle" text="Dữ liệu quét thẻ thực tế" level="H2"/>
                        <ToolbarSpacer id="tableSpacer"/>
                        <Button id="btnCancel" 
                                text="Hủy Đơn Chọn" 
                                type="Reject" 
                                icon="sap-icon://decline" 
                                press="onCancelDispute"/>
                    </OverflowToolbar>
                </headerToolbar>
                
                 <columns>

        <Column id="colWorkDate">
            <Text id="txtWorkDate" text="Ngày làm việc"/>
        </Column>

        <Column id="colRequestType">
            <Text id="txtRequestType" text="Loại yêu cầu"/>
        </Column>

        <Column id="colProposedIn">
            <Text id="txtProposedIn" text="Giờ vào đề xuất"/>
        </Column>

        <Column id="colProposedOut">
            <Text id="txtProposedOut" text="Giờ ra đề xuất"/>
        </Column>

        <Column id="colComment" width="15rem">
            <Text id="txtComment" text="Lý do"/>
        </Column>

        <Column id="colStatus">
            <Text id="txtStatus" text="Trạng thái"/>
        </Column>
        <Column
    id="colApproverComment"
    width="15rem">

    <Text
        id="txtApproverCommentHeader"
        text="Ý kiến người duyệt"/>

</Column>

    </columns>

    <items>
        <ColumnListItem id="itemDispute">
            <cells>

                <Text id="txtDate"
                      text="{path:'WorkDate',
                      type:'sap.ui.model.type.Date',
                      formatOptions:{style:'medium'}}"/>

                <Text id="txtReqType"
                      text="{RequestType}"/>

                <Text id="txtIn"
      text="{
          path:'ProposedIn',
          formatter: '.formatEdmTime'
      }"/>

<Text id="txtOut"
      text="{
          path:'ProposedOut',
          formatter: '.formatEdmTime'
      }"/>

                <Text id="txtReason"
      text="{EmployeeComment}"
      wrapping="true"
      renderWhitespace="true"
      class="sapUiSelectable forceWordBreak" />

                <ObjectStatus id="objStatus"
                              text="{DisputeStatus}"/>
                <Text id="txtApproverComment"
      text="{ApproverComment}"
      wrapping="true"
      renderWhitespace="true"
      class="sapUiSelectable forceWordBreak" />
            </cells>
        </ColumnListItem>
    </items>

</Table>
        </content>
    </Page>
</mvc:View>