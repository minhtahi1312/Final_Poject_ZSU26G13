<mvc:View
    controllerName="my.report.zmydisputes.controller.EmployeeTimesheet"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="timesheetPage" title="{i18n>titleTimesheetHistory}" showHeader="true">
        <content>
          <VBox id="vbTimesheetContainer" class="sapUiTinyMargin">
    
            <fb:FilterBar id="filterBar" search=".onSearch" reset=".onReset" clear=".onReset" showClearOnFB="true">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem id="idWorkDateFilterGroup" name="WorkDateGroup" label="{i18n>lblWorkDate}" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <DatePicker id="idWorkDateFilter" displayFormat="medium" valueFormat="yyyy-MM-dd" placeholder="{i18n>phSelectDate}"/>
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem id="idStatusFilterGroup" name="StatusGroup" label="{i18n>colStatus}" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idStatusFilter" placeholder="{i18n>phSelectStatus}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onStatusValueHelp"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table id="timesheetTable" items="{path: '/WorkingTime', sorter: { path: 'WorkDate', descending: true }, parameters: {mode: 'OneWay'}}" mode="SingleSelectLeft" growing="true" growingThreshold="10" growingScrollToLoad="false" growingTriggerText="More">
                <headerToolbar>
                    <OverflowToolbar id="tableHeader">
                        <Title id="tableTitle" text="{i18n>titleMyTimesheetData}" level="H2"/>
                        <ToolbarSpacer id="timesheetSpacer"/>
                        <Button id="btnSubmitReport" text="{i18n>btnSubmitDispute}" type="Emphasized" icon="sap-icon://request" press="onPressSubmitDispute"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
    <Column id="tsColDate"><Text id="tsLblDate" text="{i18n>lblWorkDate}" /></Column>
    <Column id="tsColShift"><Text id="tsLblShift" text="{i18n>lblShiftCode}" /></Column>
    <Column id="tsColIn" hAlign="Center"><Text id="tsLblIn" text="{i18n>colCheckIn}" /></Column>
    <Column id="tsColOut" hAlign="Center"><Text id="tsLblOut" text="{i18n>colCheckOut}" /></Column>
    <Column id="tsColTotHours" hAlign="Center"><Text id="tsLblTotHours" text="{i18n>colActualHours}" /></Column>
    <Column id="tsColHours" hAlign="Center"><Text id="tsLblHours" text="{i18n>colStdHours}" /></Column>
    <Column id="tsColOt" hAlign="Center"><Text id="tsLblOt" text="{i18n>colOtHours}" /></Column>
    <Column id="tsColStatus" hAlign="Center"><Text id="tsLblStatus" text="{i18n>colStatus}" /></Column> 
</columns>
                <items>
    <ColumnListItem id="tsRowTemplate">
        <cells>
            <Text id="tsCellTsDate" text="{path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" />
            <Text id="tsCellTsShift" text="{ShiftId}" />
            <Text id="tsCellTsIn" text="{path: 'ActIn', formatter: '.formatEdmTime'}" />
            <Text id="tsCellTsOut" text="{path: 'ActOut', formatter: '.formatEdmTime'}" />

            <ObjectNumber id="tsCellTsTotHours" 
                          number="{TotHours}" 
                          state="{= parseFloat(${TotHours}) >= parseFloat(${WorkHours}) ? 'Success' : 'Error' }" />

            <!-- Giờ chuẩn -->
            <ObjectNumber id="tsCellTsHours" number="{WorkHours}" />

            <!-- Giờ OT: Màu cam khi > 0 -->
            <ObjectNumber id="tsCellTsOt" 
                          number="{OtHours}" 
                          state="Warning" 
                          visible="{= parseFloat(${OtHours}) > 0 }" />

            <ObjectStatus id="tsCellTsStatus"
              text="{status}" 
              inverted="true"
              state="{= ${status} === 'COMPLETED' || ${status} === 'COMPLETE' ? 'Success' : 
                      (${status} === 'ABSENT' ? 'Warning' : 
                      (${status} === 'WARNING' ? 'Error' :
                      (${status} === 'LEAVE' ? 'Information' : 'None'))) }" />
        </cells>
    </ColumnListItem>
</items>
            </Table>
        </VBox>
        </content>
    </Page>
</mvc:View>