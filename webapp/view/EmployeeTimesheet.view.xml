<mvc:View
    controllerName="my.report.zmydisputes.controller.EmployeeTimesheet"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="timesheetPage" title="Lịch sử chấm công của tôi" showHeader="true">
        <content>
            <Table id="timesheetTable" 
                   items="{path: '/WorkingTime', parameters: {mode: 'OneWay'}}"
                   mode="SingleSelectLeft"
                   growing="true"
                   growingThreshold="20">
                <headerToolbar>
                    <OverflowToolbar id="tableHeader">
                        <Title id="tableTitle" text="Dữ liệu quẹt thẻ thực tế" level="H2"/>
                        <ToolbarSpacer id="timesheetSpacer"/>
                        <Button id="btnSubmitReport" 
                                text="Gửi đơn giải trình" 
                                type="Emphasized" 
                                icon="sap-icon://request" 
                                press="onPressSubmitDispute"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
    <Column id="tsColDate"><Text id="tsLblDate" text="Ngày làm việc" /></Column>
    <Column id="tsColShift"><Text id="tsLblShift" text="Mã ca" /></Column>
    <Column id="tsColIn"><Text id="tsLblIn" text="Giờ vào " /></Column>
    <Column id="tsColOut"><Text id="tsLblOut" text="Giờ ra " /></Column>
    <Column id="tsColTotHours"><Text id="tsLblTotHours" text="Tổng giờ công" /></Column>
    <Column id="tsColHours"><Text id="tsLblHours" text="Số giờ làm" /></Column>
    <Column id="tsColOt"><Text id="tsLblOt" text="Giờ OT" /></Column>
    <Column id="tsColStatus"><Text id="tsLblStatus" text="Trạng thái" /></Column> 
</columns>
<items>
    <ColumnListItem id="tsRowTemplate">
        <cells>
            <Text id="tsCellTsDate" text="{path: 'WorkDate', type: 'sap.ui.model.type.Date', formatOptions: {style: 'medium'}}" />
            <Text id="tsCellTsShift" text="{ShiftId}" />
            <Text id="tsCellTsIn" text="{path: 'ActIn', formatter: '.formatEdmTime'}" />
            <Text id="tsCellTsOut" text="{path: 'ActOut', formatter: '.formatEdmTime'}" />
            <Text id="tsCellTsTotHours" text="{TotHours}" />
            <Text id="tsCellTsHours" text="{WorkHours}" />
            <Text id="tsCellTsOt" text="{OtHours}" />
            <ObjectStatus id="tsCellTsStatus" text="{status}" state="{= ${status} === 'APPROVED' ? 'Success' : 'Warning' }" />
        </cells>
    </ColumnListItem>
</items>
            </Table>
        </content>
    </Page>
</mvc:View>